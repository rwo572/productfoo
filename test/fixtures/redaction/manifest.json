{
  "marker": "%%",
  "fixtures": [
    {
      "file": "session-aws-github.txt",
      "kind": "hot",
      "description": "agent transcript: AWS key pair + GitHub tokens",
      "expectDetectors": ["aws_access_key_id", "secret_assignment", "github_token", "github_pat"]
    },
    {
      "file": "env-dump.txt",
      "kind": "hot",
      "description": ".env paste on non-keyword keys: stripe live/test, gcp, openai, anthropic, slack",
      "expectDetectors": ["stripe_secret_key", "stripe_test_key", "gcp_api_key", "openai_key", "anthropic_key", "slack_token"]
    },
    {
      "file": "pk-jwt-db.txt",
      "kind": "hot",
      "description": "private key block, JWT, database connection string",
      "expectDetectors": ["private_key_block", "jwt", "db_connection_string"]
    },
    {
      "file": "azure-gcp-sa.txt",
      "kind": "hot",
      "description": "azure storage connection, gcp service account, keyed assignment",
      "expectDetectors": ["azure_storage_key", "gcp_service_account", "secret_assignment"]
    },
    {
      "file": "benign-code.txt",
      "kind": "benign",
      "description": "code near-misses: identifiers, placeholders, env lookups"
    },
    {
      "file": "benign-docs.txt",
      "kind": "benign",
      "description": "docs near-misses: prefix mentions, format descriptions, commit hashes"
